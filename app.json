{
  "expo": {
    "name": "Spendly",
    "slug": "spendly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.patchaiyappan.spendly",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#14213D"
      }
    },
    "ios": {
      "bundleIdentifier": "com.patchaiyappan.spendly",
      "infoPlist": {
        "UIBackgroundModes": ["fetch"]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Spendly to use Face ID to unlock the app."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#14213D",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Spendly to use your camera for your profile photo.",
          "photosPermission": "Allow Spendly to access photos for profile images and transaction proof.",
          "microphonePermission": false
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Spendly to access contacts when you choose a person to track."
        }
      ],
      "expo-build-properties"
    ],
    "extra": {
      "eas": {
        "projectId": "1a7de7c3-34e9-4037-a3fd-6578aad99979"
      }
    },
    "owner": "patchaiyappanask"
  }
}
